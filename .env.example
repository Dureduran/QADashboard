# ========================================
# Airline RM Demo: environment variables (example)
# Copy this file to .env and fill in what you need. Every value is optional:
# with nothing set, the dashboard runs on its built-in sample data.
# Never commit a real .env file.
# ========================================

# Enable live data
VITE_USE_LIVE_DATA=false

# ----------------------------------------
# 1. OpenWeatherMap (Weather Data)
# ----------------------------------------
VITE_OPENWEATHER_KEY=

# ----------------------------------------
# 2. SerpAPI (Competitor Pricing)
# ----------------------------------------
VITE_SERPAPI_KEY=

# ----------------------------------------
# 3. OpenSky Network (Flight Tracking)
# ----------------------------------------
VITE_OPENSKY_USERNAME=
VITE_OPENSKY_PASSWORD=

# ----------------------------------------
# 4. FRED (Economic Data)
# ----------------------------------------
VITE_FRED_API_KEY=

# ----------------------------------------
# 5. Supabase (Database)
# ----------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ----------------------------------------
# Optional / Future
# ----------------------------------------
# VITE_ANTHROPIC_API_KEY=
